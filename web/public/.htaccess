# Parts of this file were generated with AI assistance (Claude Code). See docs/AI_USAGE.md
# Static site on shared cPanel hosting (Apache). Shipped inside the build by Vite (web/public/).

Options -Indexes
DirectoryIndex index.html

# Force HTTPS, but leave Let's Encrypt challenges alone.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType application/geo+json .geojson
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/geo+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Hashed build assets never change: cache for a year.
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Pipeline outputs can be re-exported: revalidate hourly.
  <If "%{REQUEST_URI} =~ m#/data/#">
    Header set Cache-Control "public, max-age=3600"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
